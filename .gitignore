# Diagnostic cores copied in by hand for ?abcore= measurement. They are never part of
# build-site.ts's shipped list; if a variant is chosen for the shipped site it gets added
# there and this ignore no longer covers it. The two cores the tiles now point at —
# model2_m2b_sharc3 (Gunblade) and model2_m2o_tgp2 (Virtua Cop) — are shipped in build-site.ts
# and deliberately not listed here.
cores/model2_m2b_fast/
cores/model2_m2b_sharc2/
cores/model2_m2b_sharc4/
cores/model2_m2b_main2/
cores/model2_m2b_noq/
cores/model2_m2o_main2/

